# sandbox_service 环境变量模板：复制为同目录 .env 后按环境填写。
#
#   cp deploy/.env.example deploy/.env

SANDBOX_SERVICE_PORT=8001
SANDBOX_SERVICE_IMAGE=sandbox-service:latest

# agent 镜像：由接入方的应用仓库自行构建，本服务只负责按契约起容器。
# 换 agent 只改这一个变量（前提是新镜像通过 tests/agent_conformance）。
# 想先跑通链路可用本仓参考实现：AGENT_IMAGE=echo-agent:latest
AGENT_IMAGE=10.199.5.51:5000/tax-agent:<sha>

# 北向 Bearer token：调用方必须带 `Authorization: Bearer <此值>`。留空 = 关闭鉴权（仅本地调试）
SERVICE_TOKEN=change-me-shared-service-token

# 工作区在宿主机上的绝对路径（本服务与 agent 容器必须同路径可见——经 docker.sock 给
# agent 挂 workspace 时按宿主机路径解析，故容器内外须同路径）
SANDBOX_HOST_WORKSPACE_ROOT=/var/sandbox/workspaces

# agent 容器规格（留空用默认；AGENT_COMMAND 留空 = 用镜像自带 CMD）
AGENT_COMMAND=
AGENT_PORT=8080
AGENT_CPU=
AGENT_MEM_MB=
AGENT_NETWORK=
# agent 出网白名单（逗号分隔的主机名/IP）：留空 = 不加限制
AGENT_EGRESS_ALLOW=
# 热挂载 host:container[:mode]，逗号分隔（或用 legacy AGENT_CODE_DIR）
AGENT_CODE_MOUNTS=
AGENT_CODE_DIR=

POOL_CAPACITY=8
IDLE_TTL_SECONDS=600

# evict_candidate 自动回收宽限期（秒）。<=0 关闭（默认：服务不自行销毁空闲沙箱，等调用方 DELETE）。
# 开启后：空闲超 IDLE_TTL_SECONDS 被标记为候选，再超 EVICT_GRACE_SECONDS 仍无人认领则自动销毁。
# 总存活 ≈ IDLE_TTL_SECONDS + EVICT_GRACE_SECONDS。调用方不发 DELETE 的部署建议开启（如 3600）。
EVICT_GRACE_SECONDS=0

# 孤儿容器巡检：回收带本服务 label 却不在账本的容器（进程被 SIGKILL、stop 半途失败等）。
# ORPHAN_SWEEP_SECONDS<=0 关闭巡检；ORPHAN_MIN_AGE_SECONDS 内新建的容器一律放行，
# 否则会误杀「已创建但尚未登记租约」的在途沙箱。
ORPHAN_SWEEP_SECONDS=60
ORPHAN_MIN_AGE_SECONDS=120

# 工作区骨架目录：建沙箱时预建的空目录，按接入业务的约定填（留空 = 只建 workspace 根）
WORKSPACE_SKELETON_DIRS=

# 通用事件通知 sink（可选，部署级默认）：exit/dead/evict 事件。
# 也可让调用方在 POST /sandboxes 时按沙箱自带 callback_url，服务即无需任何全局应用地址。
CALLBACK_URL=

# 旧路由兼容 shim（被动路由翻译，供既有调用方灰期过渡）：通用部署保持 0
ENABLE_LEGACY_SHIM=0

# ObjectStore（默认 MinIO/S3 兼容；自定义后端填 OBJECT_STORE=module:factory）
MINIO_SECURE=false
SANDBOX_HOST_WORKSPACE_ROOT=/var/sandbox/workspaces
MINIO_ENDPOINT=10.199.5.51:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=servyou123
MINIO_DEFAULT_BUCKET=analysis-platform
